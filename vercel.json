{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/altaris",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/altaris/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/login.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/data/market/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/data/cbs-sales/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        }
      ]
    }
  ],
  "framework": null,
  "functions": {
    "api/gov/transactions.js": {
      "includeFiles": "{data/geo/localities.json,data/transactions/freshness.json,data/streets/evidence/meta.json,data/streets/evidence/sync-runs.jsonl}"
    },
    "api/housing.js": {
      "includeFiles": "data/housing/*.json*"
    },
    "api/land.js": {
      "includeFiles": "{data/land/*.json*,data/geo/localities.json,data/rental/*.json*,data/market/latest.json}"
    },
    "api/jobs/tx-refresh.js": {
      "maxDuration": 60,
      "includeFiles": "data/transactions/watch.json"
    },
    "api/intel.js": {
      "includeFiles": "{data/land/tenders.json,data/land/meta.json,data/land/sync-runs.jsonl,data/housing/*.json*,data/market/latest.json,data/transactions/*.json*,data/geo/*.json,data/renewal/*.json*,data/cbs-sales/*.json*,data/rental/*.json*,data/radar/*.json}"
    }
  },
  "rewrites": [
    {
      "source": "/altaris",
      "destination": "/altaris/index.html"
    }
  ]
}
