# Access password for the private site (checked server-side in /api/login).
SITE_PASSWORD=change-me
# Random secret used to sign session cookies (generate: openssl rand -hex 32).
SESSION_SECRET=change-me-too

# Optional — the dedicated PROPX Supabase project (market + user_state schemas,
# supabase/migrations/). Server-side only: GitHub Actions secrets for the daily
# data sync. Never commit real values; never expose them to the page.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
